#!/usr/bin/perl -T
# pmg-quarantine-do-action — выполняет действие над письмом в карантине PMG
# Использует PMG Perl-модули напрямую (без HTTP API, т.к. API-токены не реализованы в PMG).
#
# Использование: pmg-quarantine-do-action <id> <action>
#   id     — формат C{cid}R{rid}T{ticketid}
#   action — whitelist | blacklist | deliver | delete
#
#            pmg-quarantine-do-action --blacklist-sender <pmail> <sender>
#   Добавляет отправителя в чёрный список без привязки к записи карантина —
#   для случая, когда письмо уже удалено PMG по истечении lifetime.

use strict;
use warnings;

# Taint mode: очищаем окружение до загрузки модулей
BEGIN {
    $ENV{PATH} = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin';
    delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};
}

use PMG::DBTools;
use PMG::Quarantine;
use PMG::Utils qw(try_decode_utf8);

my $SPOOL_DIR   = '/var/spool/pmg';
my $CONFIG_PATH = '/etc/pmg-quarantine-junk/config.ini';
my $RSPAMC      = '/usr/bin/rspamc';

# ---------------------------------------------------------------------------
# Совместимость PMG 8 / PMG 9: в PMG 9 функция add_to_blackwhite переименована
# в add_to_blockwelcome (смена терминологии, сигнатура и логика те же).
# Выбираем ту, что есть, при старте — скрипт работает на обеих версиях.
# ---------------------------------------------------------------------------

my $add_to_list = PMG::Quarantine->can('add_to_blockwelcome')
    // PMG::Quarantine->can('add_to_blackwhite')
    // die "PMG::Quarantine: neither add_to_blockwelcome nor add_to_blackwhite found\n";

# ---------------------------------------------------------------------------
# Дообучение rspamd кнопками (опционально, [rspamd] learn = yes в config.ini).
# В стандартном PMG rspamd нет, поэтому по умолчанию выключено.
# ---------------------------------------------------------------------------

sub rspamd_learn_enabled {
    open(my $fh, '<', $CONFIG_PATH) or return 0;
    my $section = '';
    while (my $line = <$fh>) {
        $line =~ s/[;#].*$//;
        if ($line =~ /^\s*\[\s*([^\]]+?)\s*\]/) { $section = lc $1; next; }
        next unless $section eq 'rspamd';
        if ($line =~ /^\s*learn\s*[=:]\s*(\S+)/i) {
            close $fh;
            return lc($1) =~ /^(yes|true|on|1)$/ ? 1 : 0;
        }
    }
    close $fh;
    return 0;
}

my $RSPAMD_LEARN = rspamd_learn_enabled() && -x $RSPAMC;

sub rspamd_learn {
    my ($file_rel, $mode) = @_;  # mode: 'learn_ham' or 'learn_spam'
    return unless $RSPAMD_LEARN && $file_rel;
    # Запрещаем выход за пределы spool-каталога
    return if $file_rel =~ m{\.\.};
    # Untaint: допускаем только безопасные символы в пути
    return unless $file_rel =~ m{^([a-zA-Z0-9/_.-]+)$};
    my $path = "$SPOOL_DIR/$1";
    return unless -f $path;
    system($RSPAMC, $mode, $path);
}

# ---------------------------------------------------------------------------
# Аргументы
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Режим --blacklist-sender: письма в карантине больше нет (удалено по
# lifetime), но отправителя всё равно нужно заблокировать.
# Оба адреса приходят из action-server: pmail — из подписанного HMAC-токена,
# sender — из state.db (туда его записал нотифайер из БД PMG).
# ---------------------------------------------------------------------------

if (@ARGV == 3 && $ARGV[0] eq '--blacklist-sender') {
    my (undef, $pmail_arg, $sender_arg) = @ARGV;

    # Скобки обязательны: taint снимается ТОЛЬКО захватом подшаблона ($1),
    # значение $& остаётся «грязным» и PMG-модули его отвергнут.
    my $EMAIL_RE = qr/^([^\@\s<>"]+\@[^\@\s<>"]+\.[^\@\s<>"]+)$/;

    die "Invalid pmail\n"  unless $pmail_arg  =~ $EMAIL_RE;
    my $bw_pmail = $1;   # untaint
    die "Invalid sender\n" unless $sender_arg =~ $EMAIL_RE;
    my $bw_sender = $1;  # untaint

    my $bw_dbh = eval { PMG::DBTools::open_ruledb() };
    die "Cannot open PMG rule DB: $@\n" if $@;

    eval { $add_to_list->($bw_dbh, $bw_pmail, 'BL', [$bw_sender]) };
    if ($@) {
        print "ERROR: $@\n";
        $bw_dbh->disconnect();
        exit 1;
    }

    print "OK: sender '$bw_sender' added to blacklist for '$bw_pmail' (no quarantine entry)\n";
    $bw_dbh->disconnect();
    exit 0;
}

die "Usage: $0 <quarantine_id> <action>\n"
    . "       $0 --blacklist-sender <pmail> <sender>\n"
    unless @ARGV == 2;

my ($id, $action) = @ARGV;

die "Invalid action '$action'. Must be: whitelist|blacklist|deliver|delete\n"
    unless $action =~ /^(whitelist|blacklist|deliver|delete)$/;
$action = $1;  # untaint

die "Invalid quarantine ID '$id'. Expected format: C<n>R<n>T<n>\n"
    unless $id =~ /^C(\d+)R(\d+)T(\d+)$/;

my ($cid, $rid, $ticketid) = ($1 + 0, $2 + 0, $3 + 0);  # +0 untaints числа

# ---------------------------------------------------------------------------
# Открываем БД PMG
# ---------------------------------------------------------------------------

my $dbh = eval { PMG::DBTools::open_ruledb() };
die "Cannot open PMG rule DB: $@\n" if $@;

# ---------------------------------------------------------------------------
# Получаем запись о письме
# ---------------------------------------------------------------------------

my $sth = $dbh->prepare(
    "SELECT C.cid, C.rid, C.sender, C.file, C.spamlevel,
            R.receiver, R.pmail, R.ticketid, R.status
     FROM   CMailStore C
     JOIN   CMSReceivers R
            ON  C.cid = R.cmailstore_cid
            AND C.rid = R.cmailstore_rid
     WHERE  C.cid = ? AND C.rid = ? AND R.ticketid = ?"
);

$sth->execute($cid, $rid, $ticketid)
    or die "DB query failed: " . $dbh->errstr . "\n";

my $ref = $sth->fetchrow_hashref();
$sth->finish();

unless ($ref) {
    print "NOTFOUND: quarantine entry $id does not exist\n";
    exit 2;
}

# Уже обработано — не ошибка, просто сообщаем
if ($ref->{status} ne 'N') {
    print "ALREADY_PROCESSED: status=$ref->{status}\n";
    exit 0;
}

my $sender   = try_decode_utf8($ref->{sender}   // '');
my $pmail    = try_decode_utf8($ref->{pmail}    // '');
my $receiver = try_decode_utf8($ref->{receiver} // $ref->{pmail} // '');

# ---------------------------------------------------------------------------
# Выполняем действие
# ---------------------------------------------------------------------------

eval {
    if ($action eq 'whitelist') {
        rspamd_learn($ref->{file}, 'learn_ham');
        $add_to_list->($dbh, $pmail, 'WL', [$sender]);
        PMG::Quarantine::deliver_quarantined_mail($dbh, $ref, $receiver);
        print "OK: sender '$sender' added to whitelist for '$pmail', mail delivered\n";

    } elsif ($action eq 'blacklist') {
        rspamd_learn($ref->{file}, 'learn_spam');
        $add_to_list->($dbh, $pmail, 'BL', [$sender]);
        PMG::Quarantine::delete_quarantined_mail($dbh, $ref);
        print "OK: sender '$sender' added to blacklist for '$pmail', mail deleted\n";

    } elsif ($action eq 'deliver') {
        rspamd_learn($ref->{file}, 'learn_ham');
        PMG::Quarantine::deliver_quarantined_mail($dbh, $ref, $receiver);
        print "OK: mail delivered to '$receiver'\n";

    } elsif ($action eq 'delete') {
        PMG::Quarantine::delete_quarantined_mail($dbh, $ref);
        print "OK: mail deleted from quarantine\n";
    }
};

if ($@) {
    print "ERROR: $@\n";
    $dbh->disconnect();
    exit 1;
}

$dbh->disconnect();
exit 0;
